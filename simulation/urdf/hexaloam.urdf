    </inertial>
    <visual>
      <geometry><cylinder radius="0.038" length="0.041"/></geometry>
      <material name="amber_pla"/>
    </visual>
  </link>
  <joint name="rplidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rplidar_link"/>
    <origin xyz="-0.042 0.0 -0.029" rpy="3.14159265 0 0"/>
  </joint>

