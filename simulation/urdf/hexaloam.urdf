  <joint name="LF_COXA" type="revolute"><parent link="base_link"/><child link="LF_coxa_link"/><origin xyz="0.0779423 0.0450000 -0.0496718" rpy="0 0 0.5235987756"/><axis xyz="0 0 1"/><limit lower="-0.785398" upper="0.785398" effort="2.157" velocity="4.5"/></joint>
