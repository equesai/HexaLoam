<?xml version="1.0"?>
<!-- HexaLoam Canonical 18-DOF URDF
     Dimensions derived from simulation/cad-export/Full_Robot_Assembly.xml
     Canonical joint names: LF_COXA..RR_TIBIA (control/robot-configuration/hexaloam_config.json) -->
<!-- Joint effort = 2.157 N*m: each joint is driven by two back-to-back MG996R servos (MA1 + MA2),
     2 x 1.0787 N*m stall torque at 6.0 V. This is the stall (peak) torque; the continuous design target is 70% of it. -->
<robot name="hexaloam">
  <material name="amber_pla"><color rgba="0.85 0.47 0.02 1.0"/></material>
  <material name="slate_dark"><color rgba="0.12 0.16 0.22 1.0"/></material>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.00112 -0.019996 -0.000906" rpy="0 0 0"/>
      <mass value="0.432316"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.003"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.090" length="0.068"/></geometry>
      <material name="slate_dark"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.090" length="0.068"/></geometry>
    </collision>
  </link>

  <link name="rplidar_link">
